        "page": 11
      },
      "displayCode": {
        "cpp": "51 for (i = 1; i <= 9; i++)\n52 {\n53     j = i - 1;\n54     t = a[i];\n55     while (j >= 0)\n56     {\n57         if (t > a[j])\n58             break;\n59         a[j + 1] = a[j];\n60         j = j - 1;\n61     }\n62     a[j] = t;\n63 }"
