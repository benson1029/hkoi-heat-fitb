      "markdown": "",
      "displayCode": {
        "c": "typedef struct Node *pNode;\nstruct Node {\n  int data;\n  pNode next;\n};\n\npNode reverse(pNode src) {\n  pNode dst,temp;\n\n  dst=NULL;\n  while (src!=NULL) {\n    temp=src->next;\n    src->next={{K}};\n    dst={{L}};\n    src=temp;\n  }\n  return dst;\n}"
      }
